# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/cuadre_caja"
DIRECT_URL="postgresql://user:password@localhost:5432/cuadre_caja"

# Autenticación
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Inicialización del sistema
INIT_SECRET="your-init-secret-for-superadmin"

# Opcional: Variables de desarrollo
NODE_ENV="development"

# Activación landing (JWT en enlace /activar; vigencia 48h — ver src/constants/onboarding.ts)
ACTIVATION_JWT_SECRET="your-activation-jwt-secret"

# Invitación / restablecimiento / cambio correo de usuarios del negocio (JWT en enlace; invitación 48h, reset 24h, cambio correo 24h)
USER_ACCOUNT_JWT_SECRET="your-user-account-jwt-secret-min-32-chars"
N8N_USER_INVITE_WEBHOOK="https://n8n.example.com/webhook/user-invite/"
N8N_USER_INVITE_API_KEY="your-query-token"
N8N_USER_PASSWORD_RESET_WEBHOOK="https://n8n.example.com/webhook/user-password-reset/"
N8N_USER_PASSWORD_RESET_API_KEY="your-query-token"

# Purga vía API externa (POST .../purge-expired-freemium-landing-negocios, header x-api-key)
PURGE_LANDING_NEGOCIOS_API_KEY="your-purge-landing-negocios-api-key"

N8N_USER_EMAIL_CHANGE_WEBHOOK="n8n_url"
N8N_USER_EMAIL_CHANGE_API_KEY="n8n_api_key"

# Tasas de referencia de elTOQUE (TRMI) — opcional.
# Sin esta variable la vista de tasas de cambio funciona igual, solo oculta el panel
# de referencia. Solicitar token en https://tasas-token.eltoque.com/
# La respuesta se cachea en BD y se comparte entre todos los negocios
# (ver ELTOQUE_TTL_MINUTES en src/constants/eltoque.ts).
ELTOQUE_API_TOKEN=""
# Documentación externa del harness de agentes (NO la usa la app en runtime).
# Ruta local donde ESTE desarrollador tiene clonado el repo de queandabuscando.
# La declara .agents/features.json en references.external_docs.qab; el contrato de
# integración vive ahí y cambia conforme QAB se desarrolla, así que no hay copia
# versionada en este repo. Cada máquina pone su propia ruta.
QAB_DOCS_PATH="/ruta/local/a/queandabuscando/docs"

# Integración con queandabuscando (QAB). Origen de la tienda online, sin barra final.
# Si no está definida, el cron /api/crons/sync-tienda responde 200 sin hacer nada:
# "no configurado" no es un error. Una URL malformada sí lo es (500). Ver ADR 0014.
# Solo se acepta un origen puro (protocolo://host[:puerto]): sin ruta, query ni
# credenciales. En producción debe ser https (el qabToken viaja en la cabecera).
QAB_API_BASE_URL="https://queandabuscando.example"

# Secreto de los crons de Vercel. Se compara contra `Bearer ${CRON_SECRET}`.
# Sin ella, /api/crons/sync-tienda responde 401 siempre (fail-closed, ADR 0014).
CRON_SECRET="your-cron-secret"

# Tamaño del pool de conexiones dedicado del cliente Prisma de QAB (ADR 0015).
# Opcional; por defecto 2. Aísla la transacción larga del drenaje del pool del POS.
QAB_SYNC_DB_CONNECTION_LIMIT="2"
